# Discord Bot Token (from https://discord.com/developers/applications)
BOT_TOKEN=your_discord_bot_token_here

# Your Discord Server ID (right-click server → Copy Server ID)
GUILD_ID=123456789012345678

# Channel ID for public milestone announcements
ANNOUNCE_CHANNEL_ID=123456789012345678

# Database path (default: dsa_bot.db in project root)
DB_PATH=dsa_bot.db

# GitHub backup settings (only needed on Render, not local)
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_BACKUP_REPO=your-username/your-backup-repo
# BACKUP_INTERVAL_MINUTES=10
